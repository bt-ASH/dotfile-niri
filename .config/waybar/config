{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 8,

    "modules-left": ["clock","tray", "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10", "mpris"],

    "modules-center": ["custom/cava"],

    "modules-right": ["pulseaudio", "network", "cpu", "memory", "battery",  "custom/screenshot", "custom/power"],

    "custom/screenshot": {
        "format": "󰄄",
        "tooltip-format": "Screenshot\nLeft click: Select area\nRight click: Menu",
        "on-click": "~/.config/waybar/scripts/screenshot-area.sh",
        "on-click-right": "~/.config/waybar/scripts/screenshot.sh"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power Menu\n⏻ Shutdown\n⟳ Reboot\n⏼ Suspend\n⏾ Hibernate\n⇠ Logout",
        "on-click": "~/.config/waybar/scripts/powermenu.sh"
    },

    "mpris": {
        "format": "{status_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "format-stopped": "{status_icon} May your life bloom like a flower",
        "status-icons": {
            "playing": "",
            "paused": "󱦠",
            "stopped": ""
        },
        "dynamic-order": ["title", "artist"],
        "dynamic-separator": " · ",
        "dynamic-len": 30,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "ignored-players": []
    },

    "custom/cava": {
        "exec": "~/.config/waybar/scripts/cava.sh",
        "tooltip": false
    },

    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰥔 {:%Y-%m-%d %H:%M}",
        "tooltip-format": "<span font='JetBrains Mono Nerd Font 10'>{calendar}</span>",
        "locale": "C",
        "calendar": {
            "format": {
                "today": "<b>{}</b>"
            }
        }
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": true,
        "interval": 2,
        "on-click": "kitty -e btop"
    },

    "memory": {
        "format": " {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G",
        "on-click": "kitty -e btop"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "󰁹 {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰁺 {capacity}%",
        "on-click": "kitty -e sh -c 'upower -i /org/freedesktop/UPower/devices/battery_BAT0; read'"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤮",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "kitty -e nmtui"
    },

    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": "󰝟",
        "on-click": "pavucontrol"
    },

    "tray": {
        "spacing": 10
    }
}

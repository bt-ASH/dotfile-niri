layer-rule {
// https://yalter.github.io/niri/Configuration:-Window-Rules
// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
//    match namespace="^awww-daemon$"
    match namespace="awww-daemonoverview"
    place-within-backdrop true
}

overview {
    workspace-shadow {
  //      on
    }
    zoom 0.5
    // overview 背景模糊方案：
    // niri 不支持 overview 原生模糊，但通过 blur-overview.sh 脚本用 ImageMagick 生成
    // 模糊版壁纸后发送给独立的 awww-daemon -n overview 显示，实现模糊效果
    // 脚本路径: ~/.config/niri/scripts/blur-overview.sh
    // 换壁纸时自动触发（通过 waypaper post_command）
}

gestures {
    hot-corners {
        off
    }
}

cursor {
    xcursor-theme "YuzuhaBLZ"
    xcursor-size 16
    hide-after-inactive-ms 3000
}

recent-windows {
    // off
    debounce-ms 750

    open-delay-ms 150

    highlight {
        active-color "#1e1e2eff"
        urgent-color "#89b4fbff"
        padding 30
        corner-radius 14
    }

    previews {
        max-height 480
        max-scale 0.5
    }

    binds {
        Alt+Tab         { next-window; }
        Alt+Shift+Tab   { previous-window; }
        Alt+grave       { next-window     filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }

        Mod+Tab         { next-window; }
        Mod+Shift+Tab   { previous-window; }
        Mod+grave       { next-window     filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
    }
}

// glava 音频可视化：niri 26.04 不支持 XWayland 窗口放进 backdrop 背景层
// 所以 glava 只能作为普通窗口显示（可手动挪到角落），或等 niri 支持 backdrop layer

// Gaming optimization - disable blur/effects for fullscreen windows
window-rule {
    match app-id="Wuthering Waves.exe"
    match title=r#"^Wuthering|^鸣潮|^ww"#
    // 游戏全屏，隐藏所有特效
    open-fullscreen true
    // 禁用背景模糊（通过 background-effect 节点控制）
    background-effect {
        blur false
    }
    // 禁用装饰：窗口四角、圆角裁剪、边框
    geometry-corner-radius 0
    clip-to-geometry false
    focus-ring {
        off
    }
    // 优化透明度，减少合成开销
    opacity 1.0
    // 无阴影
    shadow {
        off
    }
}

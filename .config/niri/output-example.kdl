output "eDP-1" {
    mode "1366x768@60"
    scale 1
    transform "normal"
     // transform "270"
    position x=117 y=0
    focus-at-startup
}
output "DP-1" {
    scale 1.2
    mode "1920x1200@60"
 //   transform "180"
    position x=0 y=0
}
output "HDMI-A-2" {
    mode "2240x1400@60"
    transform "180"
    position x=0 y=0
 //   mode "1920x1080@60"
    scale 1.4
   // position x=1920 y=0
}

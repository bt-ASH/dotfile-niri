// PolKit 认证代理（GUI 密码弹窗）
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// This config is in the KDL format: https://kdl.dev
// "/-" comments out the following node.
// Check the wiki for a full description of the configuration:
// https://yalter.github.io/niri/Configuration:-Introduction

include "binds.kdl"
// Input device configuration.
// Find the full list of options on the wiki:
// https://yalter.github.io/niri/Configuration:-Input
input {
    keyboard {
        xkb {
            layout "us,ru"
	   // options "caps:swapescape,altwin:swap_lalt_lwin"
        }

        // Enable numlock on startup, omitting this setting disables it.
        numlock
    }

    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        //drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }
    focus-follows-mouse max-scroll-amount="0%"
}

include "output-example.kdl"
include "debug.kdl"

// https://yalter.github.io/niri/Configuration:-Layout

include "layout.kdl"
// 动态窗口边框颜色（由 Matugen 壁纸取色生成）
include "colors.kdl"

spawn-at-startup "nm-applet"
spawn-at-startup "waybar"
spawn-at-startup "xwayland-satellite"
spawn-at-startup "awww-daemon" "-n" "overview"
spawn-at-startup "awww-daemon"
spawn-at-startup "fcitx5 --replace -d"
spawn-at-startup "~/.config/niri/scripts/restore-wallpaper.sh"
//spawn-at-startup "~/.config/niri/scripts/wall.sh"
spawn-at-startup "~/.config/niri/scripts/swayidle.sh"
spawn-at-startup "~/.config/niri/scripts/blur-overview.sh"
spawn-sh-at-startup "clipse --listen"
spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=niri & /usr/lib/xdg-desktop-portal-gnome"
// To run a shell command (with variables, pipes, etc.), use spawn-sh-at-startup:
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"

hotkey-overlay {
    // Uncomment this line to disable the "Important Hotkeys" pop-up at startup.
    skip-at-startup
}
prefer-no-csd
//screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// 完整动画配置
include "animations.kdl"
include "blur.kdl"

environment {
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    //LC_MESSAGES "zh_CN.UTF-8"
    XMODIFIERS "@im=fcitx"
}

include "rule.kdl"


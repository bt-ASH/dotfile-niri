# Ghostty 配色, 由 matugen 随壁纸生成 (与 kitty 模板 kitty-colors.conf 保持一致)
# 输出: ~/.config/ghostty/themes/Matugen, 由 config.ghostty 中 theme = Matugen 加载

# kitty: cursor / cursor_text_color
cursor-color = #c8c3dc
cursor-text = #c9c5d0

# kitty: foreground / background
foreground = #e5e1e9
background = #141318
selection-foreground = #302e41
selection-background = #c8c3dc
# kitty: url_color #c7bfff (ghostty 1.3 暂无链接颜色选项)

palette = 0=#4c4c4c
# red
palette = 1=#ac8a8c
# green (与 blue 同色, 跟随主色)
palette = 2=#c7bfff
# yellow
palette = 3=#aca98a
# blue
palette = 4=#c7bfff
# magenta
palette = 5=#ecb8cf
# cyan (绑定次要色, 利用 fixed_dim 原生实现"调暗"效果)
palette = 6=#c8c3dc
# white
palette = 7=#f0f0f0
palette = 8=#928f99
palette = 9=#c49ea0
palette = 10=#a39ec4
palette = 11=#c4c19e
palette = 12=#a39ec4
palette = 13=#ffd8e8
palette = 14=#c8c3dc
palette = 15=#e7e7e7

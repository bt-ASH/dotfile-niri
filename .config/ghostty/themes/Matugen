# Ghostty 配色, 由 matugen 随壁纸生成 (与 kitty 模板 kitty-colors.conf 保持一致)
# 输出: ~/.config/ghostty/themes/Matugen, 由 config.ghostty 中 theme = Matugen 加载

# kitty: cursor / cursor_text_color
cursor-color = #c4c4dd
cursor-text = #c7c5d0

# kitty: foreground / background
foreground = #e4e1e9
background = #131318
selection-foreground = #2d2f42
selection-background = #c4c4dd
# kitty: url_color #bdc2ff (ghostty 1.3 暂无链接颜色选项)

palette = 0=#4c4c4c
# red
palette = 1=#ac8a8c
# green (与 blue 同色, 跟随主色)
palette = 2=#bdc2ff
# yellow
palette = 3=#aca98a
# blue
palette = 4=#bdc2ff
# magenta
palette = 5=#e7b9d5
# cyan (绑定次要色, 利用 fixed_dim 原生实现"调暗"效果)
palette = 6=#c4c4dd
# white
palette = 7=#f0f0f0
palette = 8=#91909a
palette = 9=#c49ea0
palette = 10=#a39ec4
palette = 11=#c4c19e
palette = 12=#a39ec4
palette = 13=#ffd7ef
palette = 14=#c4c4dd
palette = 15=#e7e7e7
